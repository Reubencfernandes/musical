APP_ORIGIN=http://localhost:3000

# YuE2-Turbo generation uses a private Modal L40S backend.
# Server-only proxy credentials: do not prefix these with NEXT_PUBLIC_.
MODAL_YUE2_ORIGIN=https://konkanillm--kiku-yue2-engine-web.modal.run
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Transcription, ACE-Step 1 edits, lyrics, song ideas and stems use ZeroGPU.
NEXT_PUBLIC_HF_ENGINE_SPACE=Reubencf/Kiku-Engine
NEXT_PUBLIC_HF_ENGINE_ORIGIN=https://reubencf-kiku-engine.hf.space

# Song artwork: Z-Image Turbo on its own ZeroGPU Space, called from the browser.
NEXT_PUBLIC_HF_ART_SPACE=Reubencf/Kiku-Art
NEXT_PUBLIC_HF_ART_ORIGIN=https://reubencf-kiku-art.hf.space

# The browser calls the engines directly, so these are read at build time.
# The OAuth client is this app's own /oauth/client document. Leave unset locally
# (the engine's older client is used); on the Space set it to the app's URL.
# HF_OAUTH_CLIENT_ID=https://reubencf-kiku-ai.hf.space/oauth/client

# Required in production: a 64-character random hex string, stored as a Space secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional local path to Python with yt-dlp installed. ffmpeg/ffprobe must be on PATH.
PYTHON_BIN=python
