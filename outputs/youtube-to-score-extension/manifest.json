{
  "manifest_version": 3,
  "name": "YouTube to Score",
  "version": "1.6.0",
  "description": "Record part of a YouTube video, or whatever plays in any tab, and turn it into sheet music or letter notes with SheetSage2.",
  "homepage_url": "https://github.com/Reubencfernandes/musical#chrome-extension-youtube-to-score",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "YouTube to Score",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "sidePanel",
    "nativeMessaging",
    "identity"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://*.hf.space/*",
    "https://huggingface.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
